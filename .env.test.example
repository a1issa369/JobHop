# Copy to .env.test (gitignored) and fill in two already-confirmed test
# accounts on your STAGING Supabase project. Create them once by signing up
# normally in the app and clicking the confirmation email - Playwright can't
# do that step for you, so these are reused across every test run rather
# than signing up fresh each time.
#
# Never point these at production - the e2e suite creates, edits and
# deletes real applications/friendships/duels using these accounts.

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

TEST_USER2_EMAIL=
TEST_USER2_PASSWORD=
TEST_USER2_USERNAME=

# Optional - only needed for the 2-active-duel-cap test (duelCap.spec.js).
# Leave blank to skip that test. TEST_USER3 duels TEST_USER to fill the cap;
# TEST_USER4 is kept out of every duel and used to send TEST_USER a fresh
# invite while capped, then again after a forfeit frees a slot.
TEST_USER3_EMAIL=
TEST_USER3_PASSWORD=

TEST_USER4_EMAIL=
TEST_USER4_PASSWORD=
