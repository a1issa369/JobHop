<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only the two routes that are actually public and static. Everything else
  (/, the board, profiles, challenges...) requires sign-in and redirects an
  anonymous visitor to /login, so there's nothing there for a crawler to
  index - listing them would just be noise.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://jobhop.app/login</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://jobhop.app/signup</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://jobhop.app/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://jobhop.app/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
